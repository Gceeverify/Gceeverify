# Public application and Supabase configuration. NEXT_PUBLIC_* values are
# embedded during `next build`, so set them before deploying.
NEXT_PUBLIC_SITE_URL=https://your-railway-domain.up.railway.app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase admin credential. Set one of these, preferably the
# current Supabase secret key. Never prefix either value with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PocketFi server credentials and virtual-account defaults.
POCKETFI_BUSINESS_ID=
POCKETFI_API_KEY=
POCKETFI_SECRET_KEY=
POCKETFI_VIRTUAL_ACCOUNT_BANK=kuda
POCKETFI_CUSTOMER_PHONE=

# External product-provider credentials.
BIGISUB_API_KEY=
BIGISUB_TRANSACTION_PIN=
BULKACC_API_KEY=
JAP_API_KEY=
SMSBOWER_API_KEY=
RESELLER_API_KEY=
RESELLER_API_BASE_URL=https://api.sujandepartment.com

# Server-only application configuration.
ADMIN_EMAILS=
NUMBER_ACTIVATION_TIMEOUT_MINUTES=3
USD_NGN_RATE=
BOOST_MARKUP_PERCENT=30
LOG_MARKUP_PERCENT=30
NUMBER_MARKUP_PERCENT=30
RESELLER_MARKUP_PERCENT=30
VIRTUAL_EMAIL_MARKUP_PERCENT=300
VIRTUAL_EMAIL_LOW_PRICE_THRESHOLD_NGN=90
VIRTUAL_EMAIL_LOW_PRICE_MARKUP_PERCENT=1500

# Railway injects PORT automatically. For local `npm start`, Next.js defaults
# to port 3000 when PORT is not set.

# One-time local tutorial migration only. Do not add this Vercel token to the
# Railway service after the four tutorial records have been imported.
BLOB_READ_WRITE_TOKEN=
